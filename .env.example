# ==============================================================================
# REBCO Environment Configuration Template
# ==============================================================================

# Database Connection (Render PostgreSQL or local SQLite)
# On Render: Auto-injected as postgres://... (automatically translated to postgresql+psycopg://)
DATABASE_URL=sqlite:///./rebco.db
# DATABASE_URL=postgresql+psycopg://rebco:PASSWORD@db:5432/rebco

# JWT Security & Encryption
JWT_SECRET=generate_or_paste_at_least_32_characters_random_string
JWT_EXPIRE_MINUTES=60
FIELD_ENCRYPTION_KEY=c8SPAIzE0R445ysB7ObRpDsC4YUGRFE8OHE5Jhy2xF8=

# Document Storage & Upload Limits
UPLOAD_DIR=./private_uploads
MAX_UPLOAD_MB=10

# Cross-Origin Resource Sharing (CORS)
# Use comma-separated URLs or '*' for all
CORS_ORIGINS=*

# Frontend Production Serving (set to true for unified single-service deployment)
SERVE_FRONTEND=true
